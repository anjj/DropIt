# Database (Neon)
# Pooled URL for runtime (used by the app)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.neon.tech/dropit?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct URL for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-xxx.region.neon.tech/dropit?sslmode=require"

# Local docker-compose Postgres (only used when running via docker-compose)
POSTGRES_USER=dropit
POSTGRES_PASSWORD=dropit_secret
POSTGRES_DB=dropit

# NextAuth
NEXTAUTH_URL="https://your-domain.vercel.app"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Microsoft Azure AD
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Storage (Cloudflare R2, S3-compatible)
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=dropit-uploads
